# Copy to .env and fill in real values. Never commit .env.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE=false
CSRF_TRUSTED_ORIGINS=

# Paystack — use pk_live_ / sk_live_ for real charges
PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxx

# YOLO camera MJPEG (yolo_detect.py --source usb0 …)
CAMERA_STREAM_URL=http://127.0.0.1:5001/video_feed

# Emergency email (optional SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMERGENCY_ALERT_EMAIL=sethagyeimensah2@gmail.com
